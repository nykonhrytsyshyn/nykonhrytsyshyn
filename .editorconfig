root = true

[*]

charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Indentation & Spacing

indent_style = space
indent_size = 4
tab_width = 4
ij_continuation_indent_size = 8

# Line Length & Guides

max_line_length = 120
ij_visual_guides = 80, 120


[*.{html,css,scss,yml,yaml,json,md,mdx}]

indent_size = 2
tab_width = 2
ij_continuation_indent_size = 2
